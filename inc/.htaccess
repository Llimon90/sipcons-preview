Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Solo permitir POST a send-contact.php; bloquear todo lo demás (GET directo, otros archivos).
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^send-contact\.php$ - [F]
</IfModule>

# Bloquear acceso público a la bitácora de depuración (mail-debug.log)
<IfModule mod_authz_core.c>
  <FilesMatch "\.log$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.log$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
