# =====================================================================
#  SIPCONS · sitio web estático — raíz de public_html
#  -------------------------------------------------------------------
#  IMPORTANTE:
#   /app/     -> aplicación propia. Tiene (o debe tener) su propio
#               .htaccess. Estas reglas NO la tocan.
#   /tienda/  -> WordPress (productos/tienda). WordPress genera su
#               propio .htaccess dentro de /tienda/. Estas reglas
#               NO lo tocan.
# =====================================================================

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1) No reescribir NUNCA la app ni WordPress -------------------
  RewriteRule ^app(/|$)    - [L]
  RewriteRule ^tienda(/|$) - [L]

  # No exponer el repositorio si clonas el repo con git en la raíz
  RewriteRule (^|/)\.git(/|$) - [F,L]

  # sitemap.xml ahora se genera en vivo (incluye cada ficha de producto).
  # Reescritura interna, no redirección: la URL sigue siendo /sitemap.xml,
  # sin necesidad de tocar nada en Search Console.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # productos.html e index.html pasaron a ser .php (necesitan PHP para leer
  # WooCommerce). Redirige las URLs viejas por si quedaron indexadas o
  # guardadas en algún enlace.
  RewriteRule ^productos\.html$ /productos.php [L,R=301]
  RewriteRule ^index\.html$ /index.php [L,R=301]

  # --- 2) Dominio canónico: HTTPS + sin www ------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://sipcons.com%{REQUEST_URI} [L,R=301]

  # --- 3) Redirecciones 301 de URLs viejas de WordPress -----------
  #     Google todavía tiene indexadas estas URLs de antes de la migración
  #     (sitecons.com/servicios/, /product/cas-cl-5200/, etc.) y sin estas
  #     reglas cada una regresaba 404 — el sitio se veía "roto" para Google
  #     justo en las páginas que ya traían posicionamiento.
  RewriteRule ^nosotros/?$              /quienes-somos.html            [L,R=301]
  RewriteRule ^quienes-somos/?$         /quienes-somos.html            [L,R=301]
  RewriteRule ^servicios/?$             /servicios.html                [L,R=301]
  RewriteRule ^soporte/?$               /soporte.html                  [L,R=301]
  RewriteRule ^contacto/?$              /contacto.html                 [L,R=301]
  RewriteRule ^productos/?$             /productos.php                 [L,R=301]
  RewriteRule ^calibracion/?$           /calibracion.html              [L,R=301]
  RewriteRule ^casos-de-exito/?$        /casos-de-exito.html           [L,R=301]
  #     Fichas de producto de WooCommerce: mismo slug en el catálogo nuevo.
  #     Si el producto ya no existe, producto.php manda solo a productos.php.
  RewriteRule ^produc(?:t|to)/([^/]+)/?$   /producto.php?slug=$1       [L,R=301]
  RewriteRule ^product-category/.*$        /productos.php              [L,R=301]
  RewriteRule ^tienda-online/?(.*)$        /tienda/$1                  [L,R=301]
  RewriteRule ^blog/?(.*)$                 /tienda/blog/$1             [L,R=301]
</IfModule>

# --- Página de error 404 del sitio estático ----------------------
#     (WordPress y la app manejan sus propios 404 internamente.)
ErrorDocument 404 /404.html

# --- Compresión -------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml \
    font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Caché de navegador ----------------------------------------
#     Solo para /assets/ del sitio; no afecta a /app/ ni /tienda/.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <If "%{REQUEST_URI} =~ m#\.html$# || %{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.php'">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </If>
  # Fotos de productos servidas desde WordPress para el catálogo: solo
  # cabecera de caché (no toca el resto de /tienda/, que WP administra).
  <If "%{REQUEST_URI} =~ m#^/tienda/wp-content/uploads/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>

# --- Cabeceras de seguridad para el sitio ---------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Tipos MIME (por si el server no los trae) ---------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
